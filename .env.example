# Server-only email delivery. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Google Forms submission and Brevo transactional acknowledgement.
GOOGLE_FORM_ENABLED=false
BREVO_API_KEY=
SITE_URL=http://localhost:3107
# Public, approved contact details. Rebuild after changing.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_VIMEO_URL=
# Default false while the site contains concept work / pending approved details.
SITE_PUBLISHED=false
